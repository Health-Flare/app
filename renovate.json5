{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['github>Health-Flare/renovate-configs//flutter-app.json5'],

  packageRules: [
    // Runtime app dependencies (pubspec.yaml `dependencies:`) sit on top of
    // platform channels (biometrics, secure storage, encrypted SQLite),
    // where this repo has already hit real breakage from routine-looking
    // bumps (see CLAUDE.md's biometric-gate notes). Never auto-merge these;
    // always read the changelog first.
    {
      matchManagers: ['pub'],
      matchDepTypes: ['dependencies'],
      automerge: false,
    },

    // Dev-only tooling (lints, build_runner, test helpers): lower risk than
    // runtime deps. Patch/minor can merge on their own once CI (analyze,
    // format, the offline-URL scan, and the test suite) is green.
    {
      groupName: 'dev tooling (non-major)',
      matchManagers: ['pub'],
      matchDepTypes: ['dev_dependencies'],
      matchUpdateTypes: ['patch', 'minor'],
      automerge: true,
      automergeType: 'pr',
    },

    // riverpod / flutter_riverpod / riverpod_annotation / riverpod_generator
    // must move together (they span both dependencies: and
    // dev_dependencies:, and a partial bump doesn't build: see the
    // riverpod_generator 2.x -> 4.x migration in git history). Group into
    // one PR; comes after the dev-tooling rule above so it overrides
    // auto-merge for riverpod_generator specifically.
    {
      groupName: 'riverpod',
      matchManagers: ['pub'],
      matchPackageNames: [
        'riverpod',
        'flutter_riverpod',
        'riverpod_annotation',
        'riverpod_generator',
        'riverpod_analyzer_utils',
      ],
      automerge: false,
    },

    // GitHub Actions (#107). Workflows are pinned to full commit SHAs with
    // the version in a trailing comment; Renovate keeps both current.
    // Never auto-merge: the release workflows run with the signing keys and
    // the Play/App Store credentials, so a compromised action release would
    // reach them. Grouped weekly so it's one PR to read, not six.
    {
      groupName: 'github actions',
      matchManagers: ['github-actions'],
      pinDigests: true,
      automerge: false,
    },

    // ── Coupled updates ──────────────────────────────────────────────────
    // Packages below can't move on their own: each half has a hard version
    // window against the other, so single-package PRs either break the build
    // or pass CI while leaving a broken combination one merge away. Each
    // group arrives as one PR. `separateMajorMinor: false` keeps a major
    // bump in the same PR as its partners' minors (by default Renovate
    // splits it into a `major-<group>` branch, which is how java-jdk 25
    // ended up alone in #128).

    // Android toolchain: Gradle wrapper, AGP and the Kotlin Gradle plugin
    // have min/max versions against each other (AGP 9 needs Gradle >= 9.6;
    // AGP 8.x breaks on Gradle >= 9.6), and the Gradle version caps which
    // JDK can run it. The JDK is set by `java-version` in the workflows,
    // which Renovate's github-actions manager reports as `java-jdk`; this
    // rule comes after the actions rule so it wins the group name.
    {
      groupName: 'android toolchain',
      matchManagers: ['gradle-wrapper', 'gradle'],
      separateMajorMinor: false,
      automerge: false,
    },
    {
      groupName: 'android toolchain',
      matchManagers: ['github-actions'],
      matchDepNames: ['java-jdk'],
      separateMajorMinor: false,
      automerge: false,
    },

    // Isar: the runtime, the native libs and the generator must be the same
    // version. Generated .g.dart files embed the generator version and
    // isar_community >= 3.3.2 refuses older generated code at compile time.
    // Spans pubspec.yaml, scripts/isar_codegen/ and tools/csv_import/ (the
    // latter pins an exact version and carries its own generated copies, so
    // a bump there also means regenerating them).
    {
      groupName: 'isar',
      matchManagers: ['pub'],
      matchPackageNames: ['/^isar_community/'],
      separateMajorMinor: false,
      automerge: false,
    },
  ],
}
