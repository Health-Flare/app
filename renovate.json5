{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['github>Health-Flare/renovate-configs//flutter-app.json5'],

  packageRules: [
    // Runtime app dependencies (pubspec.yaml `dependencies:`) sit on top of
    // platform channels — biometrics, secure storage, encrypted SQLite —
    // where this repo has already hit real breakage from routine-looking
    // bumps (see CLAUDE.md's biometric-gate notes). Never auto-merge these;
    // always read the changelog first.
    {
      matchManagers: ['pub'],
      matchDepTypes: ['dependencies'],
      automerge: false,
    },

    // Dev-only tooling (lints, build_runner, test helpers): lower risk than
    // runtime deps. Patch/minor can merge on their own once CI — analyze,
    // format, the offline-URL scan, and the test suite — is green.
    {
      groupName: 'dev tooling (non-major)',
      matchManagers: ['pub'],
      matchDepTypes: ['dev_dependencies'],
      matchUpdateTypes: ['patch', 'minor'],
      automerge: true,
      automergeType: 'pr',
    },

    // riverpod / flutter_riverpod / riverpod_annotation / riverpod_generator
    // must move together (they span both dependencies: and
    // dev_dependencies:, and a partial bump doesn't build — see the
    // riverpod_generator 2.x -> 4.x migration in git history). Group into
    // one PR; comes after the dev-tooling rule above so it overrides
    // auto-merge for riverpod_generator specifically.
    {
      groupName: 'riverpod',
      matchManagers: ['pub'],
      matchPackageNames: [
        'riverpod',
        'flutter_riverpod',
        'riverpod_annotation',
        'riverpod_generator',
        'riverpod_analyzer_utils',
      ],
      automerge: false,
    },

    // GitHub Actions patch/minor bumps (actions/checkout,
    // subosito/flutter-action, etc.) don't touch app code and are low-risk.
    {
      groupName: 'github actions (non-major)',
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['patch', 'minor'],
      automerge: true,
      automergeType: 'pr',
    },
  ],
}
