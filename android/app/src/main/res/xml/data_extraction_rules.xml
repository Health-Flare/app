<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+). Keeps Health Flare's data out of Google cloud backup.
  The database is not encrypted at rest, so a cloud backup would be a readable
  copy stored by Google. Data leaves the device only through the explicit
  export in Settings.

  Device-to-device transfer (cable or local Wi-Fi during new-phone setup) is
  left on: it goes straight between the user's two phones, never through a
  server, and it is the only automatic way to keep data on a new phone.
  Android 11 and below: android:allowBackup="false" in the manifest turns off
  both cloud backup and device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
