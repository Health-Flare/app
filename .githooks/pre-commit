#!/usr/bin/env bash
# Pre-commit hook — mirrors the CI gates in .github/workflows/ci.yml
# (Formatting, Offline integrity scan, Static analysis, Tests) so a commit
# that would fail CI is caught locally first.
#
# Installed via: bash scripts/setup_hooks.sh
# Skip once with: git commit --no-verify

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

STAGED_DART=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.dart$' | grep -E '^(lib|test)/' || true)

if [ -z "$STAGED_DART" ]; then
  exit 0
fi

echo "→ Formatting staged Dart files (dart format)..."
echo "$STAGED_DART" | xargs dart format --output=write >/dev/null
# Re-stage any files the formatter rewrote.
echo "$STAGED_DART" | xargs git add

echo "→ Offline integrity scan (scripts/check_urls.sh)..."
if ! bash scripts/check_urls.sh; then
  echo "❌ Offline integrity scan failed — see above."
  exit 1
fi

echo "→ Static analysis (flutter analyze --fatal-infos)..."
if ! flutter analyze --fatal-infos; then
  echo "❌ flutter analyze failed — fix the issues above before committing."
  exit 1
fi

# Golden-file tests are excluded here: they're pixel-diffed against reference
# PNGs rendered on ubuntu-latest, and commonly diff on macOS/Windows purely
# from anti-aliasing (see .github/workflows/regen-goldens.yaml). CI still
# gates them on Linux — this hook covers everything else.
TEST_TARGETS=$(find test -mindepth 1 -maxdepth 1 ! -name golden ! -name goldens)
echo "→ Running tests (flutter test, excluding test/golden)..."
if ! flutter test --reporter=compact $TEST_TARGETS; then
  echo "❌ flutter test failed — fix the failing tests above before committing."
  echo "   (Golden-file tests are skipped locally; CI verifies them on Linux.)"
  exit 1
fi

exit 0
